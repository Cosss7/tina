{
  "name": "tina",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "verify": "pnpm run format:check && pnpm run typecheck && pnpm run test",
    "tina": "node apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.3"
  }
}
